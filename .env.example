# Địa chỉ website thật (dùng cho SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://xuala.vn

# Cổng chạy Next.js (Nginx proxy vào cổng này)
PORT=3000

# ---- Nhận yêu cầu từ form qua email (khuyên dùng) ----
# Gmail: bật xác minh 2 bước rồi tạo "Mật khẩu ứng dụng" để điền SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=xualavietnam@gmail.com
SMTP_PASS=
MAIL_TO=xualavietnam@gmail.com
MAIL_FROM="Website Xưa Là <xualavietnam@gmail.com>"

# ---- Hoặc / thêm: báo về Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Thư mục lưu file data/leads.jsonl (mặc định ./data)
LEADS_DIR=
